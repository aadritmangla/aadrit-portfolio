# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Email credentials for contact form (optional if using Resend)
EMAIL_USER="MY_EMAIL_USER"
EMAIL_PASSWORD="MY_EMAIL_PASSWORD"

# Contact form provider: "resend" or "smtp"
CONTACT_PROVIDER="resend"
RESEND_API_KEY="YOUR_RESEND_API_KEY"
CONTACT_TO_EMAIL="aadritmangla@gmail.com"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, API endpoints, and SEO canonical URLs.
APP_URL="https://aadritmangla.vercel.app"
